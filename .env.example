# =============================================================================
# stonks-in-motion
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# ---- Application ----
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=logs
# Comma-separated or JSON list of allowed CORS origins.
# Only needed for cross-origin access; same-origin on Railway needs no CORS.
CORS_ORIGINS=http://localhost:5173

# ---- Finnhub ----
# Get a free key at https://finnhub.io/register
FINNHUB_API_KEY=replace_me
FINNHUB_BASE_URL=https://finnhub.io/api/v1
# JSON list of ticker symbols to track.
FINNHUB_TICKERS=["AAPL","MSFT","GOOG","AMZN","NVDA","TSLA"]
# Finnhub free tier = 60 req/min. 6 tickers at 10s = ~36 req/min, safe.
FINNHUB_POLL_INTERVAL_SECONDS=10
FINNHUB_REQUEST_TIMEOUT_SECONDS=10
FINNHUB_MAX_RETRIES=3

# ---- Kafka (Aiven) ----
# Find these in the Aiven console under your Kafka service -> Connection info.
# Typical form: my-project-my-kafka.aivencloud.com:13038
KAFKA_BOOTSTRAP_SERVERS=replace_me.aivencloud.com:13038
# Auth mode:
#   SSL            = mTLS (client cert + key). Default; Aiven ships mTLS-only.
#   SASL_SSL       = username + password (Aiven services with SASL enabled).
#   PLAINTEXT      = no auth, no TLS. Local dev only.
#   SASL_PLAINTEXT = SASL with no TLS. Local dev only.
KAFKA_SECURITY_PROTOCOL=SSL
# Required only when KAFKA_SECURITY_PROTOCOL starts with "SASL_".
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TOPIC=stonks.raw.quotes
KAFKA_CLIENT_ID=stonks-in-motion
# "native" = confluent-kafka wire protocol (recommended).
# "rest"   = Karapace/REST proxy (stubbed, V2+).
KAFKA_TRANSPORT=native
# Required only when KAFKA_TRANSPORT=rest.
KAFKA_REST_BASE_URL=
# Optional: pin a CA bundle. Aiven's broker cert chains to Let's Encrypt,
# which is already in the system trust store (package `ca-certificates`),
# so this is usually left empty. Set it only if you want to pin a specific
# cert (e.g. one downloaded from the Aiven console).
KAFKA_SSL_CA_LOCATION=
# Optional: mTLS client cert + key. Aiven ships every Kafka service with
# mTLS access certs. Set BOTH to the files on disk to enable mTLS. Leave
# both empty for SASL-only auth.
KAFKA_SSL_CERTIFICATE_LOCATION=
KAFKA_SSL_KEY_LOCATION=
