[Unit]
Description=stonks-in-motion: Finnhub -> Aiven Kafka streaming pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stonks
Group=stonks
WorkingDirectory=/opt/stonks-in-motion
EnvironmentFile=/opt/stonks-in-motion/.env
ExecStart=/opt/stonks-in-motion/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
# Kill only the main process; the lifespan's stop_all() handler cleans up
# the producer/consumer children. If the process hangs irrecoverably,
# systemd will SIGKILL the main process and let init reap the orphans.
KillMode=process
# Hard cap on shutdown so the deploy workflow's health check is bounded.
TimeoutStopSec=20
# Production hardening.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/stonks-in-motion/logs
# Treat warnings about this unit as errors.
# (Optional) Limit file descriptors / memory if desired:
# LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
